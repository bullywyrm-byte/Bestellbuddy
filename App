        window.deleteProduct = (id) => {
            const product = products.find(p => p.id === id);
            showModal("Löschen bestätigen", `Möchtest du das Produkt "${product?.name}" wirklich löschen?`, true, async (pwd) => {
                if(pwd) {
                    try {
                        await deleteDoc(doc(db, getBasePath('products'), id));
                        showModal("Erfolg", "Produkt gelöscht.");
                    } catch(e) {
                        console.error(e);
                    }
                }
            });
            document.getElementById('modal-input-container').classList.add('hidden');
