        document.getElementById('order-uhrzeit').value = now.toTimeString().slice(0,5);
        document.getElementById('missing-print-date').textContent = new Date().toLocaleDateString('de-DE');

        // ====== Custom UI Modals ======
        const modal = document.getElementById('custom-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalMsg = document.getElementById('modal-message');
