                tr.innerHTML = `
                    <td class="px-4 py-3 whitespace-nowrap font-medium text-gray-900">${p.name}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-500">${p.teigart}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-500">${p.gewicht}g</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-500">${p.preis.toFixed(2)}€</td>
                    <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                        <button onclick="editProduct('${p.id}')" class="text-indigo-600 hover:text-indigo-900 mr-3">Bearbeiten</button>
                        <button onclick="deleteProduct('${p.id}')" class="text-red-600 hover:text-red-900">Löschen</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        };

        // ====== Tab 5: Einstellungen & Backup ======
        
        document.getElementById('btn-force-sync').addEventListener('click', () => {
            const status = document.getElementById('sync-status');
            status.classList.remove('hidden');
            setTimeout(() => { status.classList.add('hidden'); }, 3000);
        });

        document.getElementById('btn-export-backup').addEventListener('click', () => {
            const backupData = {
                timestamp: new Date().toISOString(),
                products: products,
                orders: orders,
                missingItems: missingItems
            };
            
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData, null, 2));
            const downloadAnchorNode = document.createElement('a');
            downloadAnchorNode.setAttribute("href", dataStr);
            downloadAnchorNode.setAttribute("download", `baeckerei_backup_${getTodayDateStr()}.json`);
            document.body.appendChild(downloadAnchorNode);
            downloadAnchorNode.click();
            downloadAnchorNode.remove();
        });

        document.getElementById('btn-import-backup').addEventListener('click', () => {
            const fileInput = document.getElementById('backup-file-input');
            if (!fileInput.files.length) {
                showModal("Hinweis", "Bitte wähle zuerst eine JSON-Backup-Datei aus.");
                return;
            }

            showModal("Sicherheitsabfrage", "Bitte gib das Backup-Passwort ein, um die Daten wiederherzustellen. (Achtung: Dies überschreibt bestehende identische Datensätze).", true, (inputValue) => {
                if (inputValue !== "31123112") {
                    document.getElementById('modal-error').classList.remove('hidden');
                    return; 
                }
                
                document.getElementById('custom-modal').classList.add('hidden');
                processBackupImport(fileInput.files[0]);
            });
        });

        const processBackupImport = (file) => {
            if(!firebaseUser || !currentWorkspace) return;
            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (!data.products && !data.orders) throw new Error("Ungültiges Format");

                    document.getElementById('loading-indicator').classList.remove('hidden');

                    if (data.products) {
                        for (const p of data.products) {
                            const { id, ...prodData } = p;
                            await setDoc(doc(db, getBasePath('products'), id), prodData);
                        }
                    }
                    if (data.orders) {
                        for (const o of data.orders) {
                            const { id, ...orderData } = o;
                            await setDoc(doc(db, getBasePath('orders'), id), orderData);
                        }
                    }
                    if (data.missingItems) {
                        for (const m of data.missingItems) {
                            const { id, ...mData } = m;
                            await setDoc(doc(db, getBasePath('missing_items'), id), mData);
                        }
                    }

                    document.getElementById('loading-indicator').classList.add('hidden');
                    showModal("Erfolg", "Backup wurde erfolgreich wiederhergestellt!");
                    document.getElementById('backup-file-input').value = ""; 
                    
                } catch (error) {
                    console.error("Import error:", error);
                    document.getElementById('loading-indicator').classList.add('hidden');
                    showModal("Fehler", "Die Datei konnte nicht gelesen werden oder ist beschädigt.");
                }
            };
            reader.readAsText(file);
        };

    </script>
</body>
</html>
