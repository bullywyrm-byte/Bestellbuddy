<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bäckerei Bestell & Produktions-App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Custom Styles & Print CSS */
        @media print {
            body { background-color: white; color: black; }
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            .print-container { width: 100%; margin: 0; padding: 0; }
            .print-break { page-break-after: always; }
            .shadow-md { box-shadow: none !important; }
            .bg-white { background-color: transparent !important; }
        }
        
        .print-only { display: none; }
        
        /* Modal Animation */
        .modal-fade {
            transition: opacity 0.2s ease-in-out;
        }
        
        /* Touch friendly inputs */
        input, select, button {
            min-height: 44px;
        }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 font-sans min-h-screen flex flex-col">

    <!-- Auth Overlay (Login/Register) -->
    <div id="auth-overlay" class="fixed inset-0 bg-gray-900 bg-opacity-95 z-[100] flex items-center justify-center p-4 transition-opacity duration-300">
        <div class="bg-white p-6 md:p-8 rounded-xl shadow-2xl max-w-md w-full">
            <h2 class="text-3xl font-bold text-center text-amber-600 mb-8 tracking-wider flex justify-center items-center gap-2">
                🍞 BäckereiApp
            </h2>
            
            <!-- Login Form -->
            <div id="form-login" class="space-y-5">
                <h3 class="text-xl font-semibold text-gray-800 text-center border-b pb-3 mb-2">Gerät Anmelden & Synchronisieren</h3>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Benutzername</label>
                    <input type="text" id="log-user" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition" placeholder="Z.B. Filiale1">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Passwort</label>
                    <input type="password" id="log-pass" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition" placeholder="******">
                </div>
                <button id="btn-do-login" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 rounded-lg shadow-md transition text-lg mt-2">Einloggen</button>
                <div class="text-center mt-6 pt-4 border-t border-gray-100 text-sm text-gray-600">
                    Noch kein Account? <button id="btn-show-register" class="text-amber-600 font-bold hover:text-amber-800 hover:underline transition">Hier registrieren</button>
                </div>
            </div>

            <!-- Register Form -->
            <div id="form-register" class="space-y-5 hidden">
                <h3 class="text-xl font-semibold text-gray-800 text-center border-b pb-3 mb-2">Neues Konto erstellen</h3>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Inhaber Code <span class="text-red-500">*</span></label>
                    <input type="password" id="reg-code" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="Code eingeben">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Wunsch-Benutzername</label>
                    <input type="text" id="reg-user" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="Ohne Leerzeichen">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Passwort (mind. 6 Zeichen)</label>
                    <input type="password" id="reg-pass" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition" placeholder="******">
                </div>
                <button id="btn-do-register" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow-md transition text-lg mt-2">Konto erstellen</button>
                <div class="text-center mt-6 pt-4 border-t border-gray-100 text-sm text-gray-600">
                    Bereits ein Konto? <button id="btn-show-login" class="text-blue-600 font-bold hover:text-blue-800 hover:underline transition">Zum Login</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="bg-amber-600 text-white shadow-lg no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center">
                    <span class="font-bold text-xl tracking-wider">🍞 BäckereiApp</span>
                </div>
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <button onclick="switchTab('tab-bestellung')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium bg-amber-700" data-target="tab-bestellung">Bestellung</button>
                        <button onclick="switchTab('tab-uebersicht')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-500 transition" data-target="tab-uebersicht">Übersichten</button>
                        <button onclick="switchTab('tab-fehlartikel')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-500 transition" data-target="tab-fehlartikel">Fehlartikel</button>
                        <button onclick="switchTab('tab-produkte')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-500 transition" data-target="tab-produkte">Produkte</button>
                        <button onclick="switchTab('tab-einstellungen')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium hover:bg-amber-500 transition" data-target="tab-einstellungen">Einstellungen</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Mobile Nav (Scrollable horizontal) -->
        <div class="md:hidden overflow-x-auto whitespace-nowrap bg-amber-700 px-2 py-2 flex space-x-2">
            <button onclick="switchTab('tab-bestellung')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium bg-amber-800" data-target="tab-bestellung">Bestellung</button>
            <button onclick="switchTab('tab-uebersicht')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium" data-target="tab-uebersicht">Übersichten</button>
            <button onclick="switchTab('tab-fehlartikel')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium" data-target="tab-fehlartikel">Fehlartikel</button>
            <button onclick="switchTab('tab-produkte')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium" data-target="tab-produkte">Produkte</button>
            <button onclick="switchTab('tab-einstellungen')" class="nav-btn px-3 py-2 rounded-md text-sm font-medium" data-target="tab-einstellungen">Setup</button>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow w-full max-w-5xl mx-auto p-4 sm:p-6 print-container">
        
        <!-- Loading Indicator -->
        <div id="loading-indicator" class="flex justify-center items-center py-10 no-print">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-amber-600"></div>
            <span class="ml-3 text-gray-500">Synchronisiere Cloud-Daten...</span>
        </div>

        <!-- TAB 1: Bestellung -->
        <div id="tab-bestellung" class="tab-content hidden">
            <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2 no-print">Neue Bestellung aufnehmen</h2>
            
            <div class="bg-white p-6 rounded-lg shadow-md mb-6 no-print">
                <h3 class="text-lg font-semibold mb-4 text-amber-600">Kundendaten</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Kundenname</label>
                        <input type="text" id="order-kundenname" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Name des Kunden">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Ort / Filiale</label>
                        <input type="text" id="order-ort" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Abholort">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Datum</label>
                        <input type="date" id="order-datum" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Uhrzeit</label>
                        <input type="time" id="order-uhrzeit" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-md mb-6 no-print">
                <h3 class="text-lg font-semibold mb-4 text-amber-600">Produkte hinzufügen</h3>
                <div class="flex flex-col md:flex-row gap-4 mb-4">
                    <select id="order-product-select" class="flex-grow border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                        <option value="">-- Produkt wählen --</option>
                        <!-- Options generated by JS -->
                    </select>
                    <input type="number" id="order-product-qty" min="1" value="1" class="w-full md:w-32 border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Menge">
                    <button id="btn-add-product-to-order" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-medium transition">Hinzufügen</button>
                </div>

                <div class="mt-4">
                    <h4 class="font-medium text-gray-700 mb-2">Aktuelle Artikelliste:</h4>
                    <ul id="current-order-items" class="divide-y divide-gray-200 border rounded bg-gray-50 empty:hidden">
                        <!-- Items generated by JS -->
                    </ul>
                    <p id="empty-order-msg" class="text-sm text-gray-500 italic mt-2">Noch keine Produkte hinzugefügt.</p>
                </div>
            </div>

            <button id="btn-save-order" class="w-full bg-green-600 hover:bg-green-700 text-white text-lg font-bold py-4 rounded-lg shadow transition no-print">
                Bestellung Speichern (Cloud Sync)
            </button>
        </div>

        <!-- TAB 2: Übersichten -->
        <div id="tab-uebersicht" class="tab-content hidden">
            <div class="flex justify-between items-center mb-6 no-print">
                <h2 class="text-2xl font-bold text-gray-800">Übersichten & Drucken</h2>
                <button onclick="window.print()" class="bg-gray-800 hover:bg-black text-white px-4 py-2 rounded shadow flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Drucken
                </button>
            </div>

            <div class="bg-white p-4 rounded-lg shadow-md mb-6 no-print">
                <label class="block text-sm font-medium text-gray-700 mb-2">Zeitraum wählen:</label>
                <div class="flex flex-wrap gap-2">
                    <button class="filter-btn bg-amber-100 text-amber-800 border border-amber-300 px-4 py-2 rounded active" data-filter="today">Heute</button>
                    <button class="filter-btn bg-gray-100 text-gray-800 border border-gray-300 px-4 py-2 rounded" data-filter="tomorrow">Morgen</button>
                    <button class="filter-btn bg-gray-100 text-gray-800 border border-gray-300 px-4 py-2 rounded" data-filter="week">Diese Woche</button>
                    <button class="filter-btn bg-gray-100 text-gray-800 border border-gray-300 px-4 py-2 rounded" data-filter="month">Dieser Monat</button>
                </div>
            </div>

            <!-- Print Headers -->
            <div class="print-only mb-6 text-center">
                <h1 class="text-3xl font-bold" id="print-header-title">Bestellübersicht</h1>
                <p class="text-lg text-gray-600" id="print-header-date"></p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Ansicht A: Produktionszettel -->
                <div class="bg-white p-6 rounded-lg shadow-md print:shadow-none print:p-0">
                    <h3 class="text-xl font-bold mb-4 text-amber-700 border-b pb-2">Produktionszettel</h3>
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm whitespace-nowrap border-collapse">
                            <thead class="bg-gray-100 border-b">
                                <tr>
                                    <th class="px-4 py-3 font-medium text-gray-900">Produkt</th>
                                    <th class="px-4 py-3 font-medium text-gray-900">Teigart</th>
                                    <th class="px-4 py-3 font-medium text-gray-900 text-right">Stückzahl</th>
                                    <th class="px-4 py-3 font-medium text-gray-900 text-right">Teiggewicht (Ges.)</th>
                                </tr>
                            </thead>
                            <tbody id="production-list" class="divide-y divide-gray-200">
                                <!-- Generated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="print-break"></div>

                <!-- Ansicht B: Kundenbestellungen -->
                <div class="bg-white p-6 rounded-lg shadow-md print:shadow-none print:p-0 mt-8 lg:mt-0">
                    <h3 class="text-xl font-bold mb-4 text-blue-700 border-b pb-2">Kundenbestellungen (Chronologisch)</h3>
                    <div id="customer-orders-list" class="space-y-6">
                        <!-- Generated by JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: Fehlartikel -->
        <div id="tab-fehlartikel" class="tab-content hidden">
            <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2 no-print">Fehlartikel (Ausverkauft)</h2>
            <p class="text-gray-600 mb-6 no-print">Tippe auf ein Produkt, wenn ein Kunde danach gefragt hat, es aber ausverkauft ist.</p>

            <div id="missing-buttons-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-8 no-print">
                <!-- Generated by JS -->
            </div>

            <div class="bg-white p-6 rounded-lg shadow-md mt-8">
                <div class="flex justify-between items-center mb-4 border-b pb-2">
                    <h3 class="text-xl font-bold text-red-600">Zusammenfassung: Fehlartikel Heute</h3>
                    <button onclick="window.print()" class="no-print text-sm bg-gray-200 hover:bg-gray-300 px-3 py-1 rounded">Drucken</button>
                </div>
                <div class="print-only text-center mb-4">
                    <h2 class="text-2xl font-bold">Fehlartikel - <span id="missing-print-date"></span></h2>
                </div>
                <ul id="missing-summary-list" class="divide-y divide-gray-200">
                    <!-- Generated by JS -->
                </ul>
            </div>
        </div>

        <!-- TAB 4: Produkte -->
        <div id="tab-produkte" class="tab-content hidden no-print">
            <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">Stammdaten: Produkte</h2>

            <div class="bg-white p-6 rounded-lg shadow-md mb-8">
                <h3 class="text-lg font-semibold mb-4 text-amber-600" id="product-form-title">Neues Produkt anlegen</h3>
                <form id="product-form" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <input type="hidden" id="prod-id">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Produktname</label>
                        <input type="text" id="prod-name" required class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Teigart</label>
                        <input type="text" id="prod-teigart" required class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Gewicht pro Stück (in Gramm)</label>
                        <input type="number" id="prod-gewicht" required min="1" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Verkaufspreis (€)</label>
                        <input type="number" id="prod-preis" required min="0" step="0.01" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    <div class="md:col-span-2 flex justify-end gap-2 mt-2">
                        <button type="button" id="btn-cancel-edit" class="hidden bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded transition">Abbrechen</button>
                        <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-2 rounded font-medium transition shadow">Speichern</button>
                    </div>
                </form>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold mb-4 text-gray-800">Produktliste</h3>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-gray-50 border-b">
                            <tr>
                                <th class="px-4 py-3 font-medium text-gray-900">Name</th>
                                <th class="px-4 py-3 font-medium text-gray-900">Teigart</th>
                                <th class="px-4 py-3 font-medium text-gray-900">Gewicht</th>
                                <th class="px-4 py-3 font-medium text-gray-900">Preis</th>
                                <th class="px-4 py-3 font-medium text-gray-900 text-right">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody id="product-list-table" class="divide-y divide-gray-200">
                            <!-- Generated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 5: Einstellungen -->
        <div id="tab-einstellungen" class="tab-content hidden no-print">
            <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">Einstellungen & Cloud</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Account Info -->
                <div class="bg-white p-6 rounded-lg shadow-md md:col-span-2 border-l-4 border-amber-600">
                    <h3 class="text-lg font-semibold mb-2 text-gray-800">Aktuelles Konto</h3>
                    <p class="text-sm text-gray-600 mb-4">Du bist angemeldet und synchronisierst deine Daten sicher über die Cloud.</p>
                    <button id="btn-do-logout" class="bg-red-100 text-red-700 border border-red-300 hover:bg-red-200 px-4 py-2 rounded transition flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                        Ausloggen
                    </button>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold mb-2 text-gray-800">Synchronisation</h3>
                    <p class="text-sm text-gray-600 mb-4">Die App synchronisiert sich automatisch mit der Cloud, sobald eine Internetverbindung besteht. Du kannst die Daten hier manuell neu laden.</p>
                    <button id="btn-force-sync" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded transition flex justify-center items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        Daten manuell synchronisieren
                    </button>
                    <div id="sync-status" class="mt-3 text-sm text-center text-green-600 font-medium hidden">Synchronisation erfolgreich!</div>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-md">
                    <h3 class="text-lg font-semibold mb-2 text-gray-800">Datensicherung (Backup)</h3>
                    <p class="text-sm text-gray-600 mb-4">Exportiere alle Cloud-Daten als JSON-Datei oder stelle ein Backup wieder her.</p>
                    
                    <button id="btn-export-backup" class="w-full mb-3 bg-gray-800 hover:bg-black text-white px-4 py-2 rounded transition">
                        📥 Backup herunterladen (Export)
                    </button>
                    
                    <div class="border-t pt-4 mt-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Backup wiederherstellen</label>
                        <input type="file" id="backup-file-input" accept=".json" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 mb-3">
                        <button id="btn-import-backup" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">
                            📤 Backup wiederherstellen (Import)
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Custom Modal for Alerts/Prompts -->
    <div id="custom-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-[110] hidden modal-fade no-print">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6 mx-4">
            <h3 id="modal-title" class="text-xl font-bold mb-2 text-gray-900">Meldung</h3>
            <p id="modal-message" class="text-gray-600 mb-4">Nachrichtentext hier...</p>
            
            <div id="modal-input-container" class="hidden mb-4">
                <input type="password" id="modal-input" class="w-full border border-gray-300 rounded p-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Passwort eingeben...">
                <p id="modal-error" class="text-red-500 text-xs mt-1 hidden">Falsches Passwort!</p>
            </div>

            <div class="flex justify-end gap-3 mt-6">
                <button id="modal-btn-cancel" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded transition hidden">Abbrechen</button>
                <button id="modal-btn-confirm" class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded transition">OK</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, addDoc, getDoc, getDocs, updateDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global State
        let firebaseUser = null;
        let currentWorkspace = null;
        let products = [];
        let orders = [];
        let missingItems = [];
        let currentOrderItems = [];
        let currentFilter = 'today';
        
        let unsubProducts = null;
        let unsubOrders = null;
        let unsubMissing = null;
        let isAppReady = false;

        const firebaseConfig = {
