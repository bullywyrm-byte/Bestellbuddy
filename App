            const prodArray = Object.values(productionTotals).sort((a,b) => {
                if(a.teigart < b.teigart) return -1;
                if(a.teigart > b.teigart) return 1;
                return a.name.localeCompare(b.name);
            });

            if (prodArray.length === 0) {
                prodTbody.innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">Keine Daten für diesen Zeitraum.</td></tr>';
            } else {
                prodArray.forEach(p => {
                    const totalWeight = (p.totalQty * p.gewicht) / 1000; 
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="px-4 py-3 whitespace-nowrap">${p.name}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-gray-600">${p.teigart}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-right font-bold text-lg">${p.totalQty}</td>
                        <td class="px-4 py-3 whitespace-nowrap text-right text-gray-600">${totalWeight.toFixed(2)} kg</td>
                    `;
                    prodTbody.appendChild(tr);
                });
            }

            const custContainer = document.getElementById('customer-orders-list');
            custContainer.innerHTML = '';

            const sortedOrders = [...filteredOrders].sort((a, b) => {
                const dateA = new Date(`${a.datum}T${a.uhrzeit || '00:00'}`);
                const dateB = new Date(`${b.datum}T${b.uhrzeit || '00:00'}`);
                return dateA - dateB;
            });

            if (sortedOrders.length === 0) {
                custContainer.innerHTML = '<p class="text-gray-500 italic">Keine Bestellungen vorhanden.</p>';
            } else {
                sortedOrders.forEach(order => {
                    const div = document.createElement('div');
                    div.className = "border rounded p-4 bg-gray-50 print:bg-transparent print:border-gray-300";
                    
                    let itemsHtml = order.items.map(i => `<div class="flex justify-between py-1 border-b border-gray-100 last:border-0"><span class="font-medium">${i.qty}x ${i.name}</span><span class="text-gray-500 text-sm">${i.teigart}</span></div>`).join('');

                    const dateObj = new Date(order.datum);
                    const formattedDate = dateObj.toLocaleDateString('de-DE');

                    div.innerHTML = `
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <h4 class="font-bold text-lg text-gray-900">${order.kundenname}</h4>
                                <p class="text-sm text-gray-600">${order.ort || 'Kein Ort'}</p>
                            </div>
                            <div class="text-right">
                                <span class="block font-bold text-amber-700">${order.uhrzeit} Uhr</span>
                                <span class="block text-sm text-gray-500">${formattedDate}</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            ${itemsHtml}
                        </div>
                    `;
                    custContainer.appendChild(div);
                });
            }
        };

        // ====== Tab 3: Fehlartikel ======
        const renderMissingItemsButtons = () => {
            const grid = document.getElementById('missing-buttons-grid');
            grid.innerHTML = '';
            
            products.forEach(p => {
                const btn = document.createElement('button');
                btn.className = "bg-white border-2 border-red-200 hover:border-red-500 hover:bg-red-50 text-gray-800 p-4 rounded-xl shadow-sm transition flex flex-col items-center justify-center min-h-[100px]";
                btn.innerHTML = `
                    <span class="font-bold text-center leading-tight mb-1">${p.name}</span>
                    <span class="text-xs text-gray-500">+1 Notieren</span>
                `;
                btn.onclick = () => registerMissingItem(p);
                grid.appendChild(btn);
            });
        };

        const registerMissingItem = async (product) => {
            if (!firebaseUser || !currentWorkspace) return;
            const today = getTodayDateStr();
            
            const existing = missingItems.find(m => m.datum === today && m.productId === product.id);
            
            try {
                if (existing) {
                    await updateDoc(doc(db, getBasePath('missing_items'), existing.id), {
                        count: existing.count + 1
                    });
                } else {
                    await addDoc(collection(db, getBasePath('missing_items')), {
                        datum: today,
                        productId: product.id,
                        name: product.name,
                        count: 1
                    });
                }
                const btn = Array.from(document.getElementById('missing-buttons-grid').children).find(b => b.textContent.includes(product.name));
