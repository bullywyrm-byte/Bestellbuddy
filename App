                    const oldBg = btn.className;
                    btn.className = "bg-red-500 text-white border-red-600 p-4 rounded-xl shadow-sm flex flex-col items-center justify-center min-h-[100px]";
                    setTimeout(() => { btn.className = oldBg; }, 300);
                }
            } catch (error) {
                console.error("Error updating missing item:", error);
            }
        };

        const renderMissingSummary = () => {
            const ul = document.getElementById('missing-summary-list');
            ul.innerHTML = '';
            const today = getTodayDateStr();
            const todaysItems = missingItems.filter(m => m.datum === today).sort((a,b) => b.count - a.count);

            if(todaysItems.length === 0){
                ul.innerHTML = '<li class="py-4 text-center text-gray-500 italic">Heute keine Fehlartikel erfasst.</li>';
                return;
            }

            todaysItems.forEach(item => {
                const li = document.createElement('li');
                li.className = "flex justify-between items-center py-3";
                li.innerHTML = `
                    <span class="font-medium text-gray-800">${item.name}</span>
                    <span class="bg-red-100 text-red-800 font-bold px-3 py-1 rounded-full">${item.count}x vermisst</span>
                `;
                ul.appendChild(li);
            });
        };


        // ====== Tab 4: Produkte (CRUD) ======
        const productForm = document.getElementById('product-form');
        const btnCancelEdit = document.getElementById('btn-cancel-edit');

        productForm.addEventListener('submit', async (e) => {
