        const modalInput = document.getElementById('modal-input');
        const modalError = document.getElementById('modal-error');
        const btnCancel = document.getElementById('modal-btn-cancel');
        const btnConfirm = document.getElementById('modal-btn-confirm');

        let modalConfirmCallback = null;

        function showModal(title, message, isPrompt = false, callback = null) {
            modalTitle.textContent = title;
            modalMsg.textContent = message;
            modalError.classList.add('hidden');
            modalInput.value = '';
            
            if (isPrompt) {
                modalInputContainer.classList.remove('hidden');
                btnCancel.classList.remove('hidden');
            } else {
                modalInputContainer.classList.add('hidden');
                btnCancel.classList.add('hidden');
            }

            modalConfirmCallback = callback;
            modal.classList.remove('hidden');
        }

        btnCancel.onclick = () => { modal.classList.add('hidden'); };
        btnConfirm.onclick = () => {
            if (modalInputContainer.classList.contains('hidden')) {
                modal.classList.add('hidden');
                if (modalConfirmCallback) modalConfirmCallback(true);
            } else {
                if (modalConfirmCallback) modalConfirmCallback(modalInput.value);
            }
        };

        // ====== Tab Navigation ======
        window.switchTab = function(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(el => {
                if(el.dataset.target === tabId) {
                    el.classList.add('bg-amber-800');
                    el.classList.remove('bg-amber-700');
                } else {
                    el.classList.remove('bg-amber-800');
                    el.classList.add('bg-amber-700');
                }
            });
            document.getElementById(tabId).classList.remove('hidden');
            
            if(tabId === 'tab-uebersicht') renderOverviews();
        };

        // ====== Authentication & Data Loading ======
        
        const authOverlay = document.getElementById('auth-overlay');
        const formLogin = document.getElementById('form-login');
        const formRegister = document.getElementById('form-register');

        document.getElementById('btn-show-register').onclick = () => {
            formLogin.classList.add('hidden');
            formRegister.classList.remove('hidden');
        };
        document.getElementById('btn-show-login').onclick = () => {
            formRegister.classList.add('hidden');
            formLogin.classList.remove('hidden');
        };

        const proceedToApp = () => {
            authOverlay.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => authOverlay.classList.add('hidden'), 300);
            
            document.getElementById('log-pass').value = '';
            document.getElementById('reg-code').value = '';
            document.getElementById('reg-pass').value = '';
            
            setupListeners();
        };

        // Register Action
        document.getElementById('btn-do-register').onclick = async () => {
            if (!firebaseUser) return showModal("Bitte warten", "Verbindung zum Server wird aufgebaut...");
            const code = document.getElementById('reg-code').value;
            const username = document.getElementById('reg-user').value;
            const pass = document.getElementById('reg-pass').value;

            if (code !== '31123112') {
                showModal("Sicherheitsprüfung", "Der Inhaber Code ist leider falsch.");
                return;
            }
            if (!username || username.trim().length < 3) {
                showModal("Fehler", "Benutzername muss mindestens 3 Zeichen haben.");
                return;
            }
            if (pass.length < 6) {
                showModal("Fehler", "Passwort muss mindestens 6 Zeichen lang sein.");
                return;
            }

            const workspaceId = formatUsernameToWorkspace(username);

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'app_accounts', workspaceId);
                const docSnap = await getDoc(docRef);

                if (docSnap.exists()) {
                    showModal("Fehler", "Dieser Benutzername existiert bereits. Bitte logge dich ein.");
                } else {
                    await setDoc(docRef, { password: pass, createdAt: new Date().toISOString() });
                    currentWorkspace = workspaceId;
                    proceedToApp();
                }
            } catch (error) {
                console.error("Register Error:", error);
                showModal("Fehler", "Registrierung auf dem Server fehlgeschlagen.");
            }
        };

        // Login Action
        document.getElementById('btn-do-login').onclick = async () => {
            if (!firebaseUser) return showModal("Bitte warten", "Verbindung zum Server wird aufgebaut...");
            const username = document.getElementById('log-user').value;
            const pass = document.getElementById('log-pass').value;

            if (!username || !pass) {
                showModal("Fehler", "Bitte Benutzername und Passwort eingeben.");
                return;
            }

            const workspaceId = formatUsernameToWorkspace(username);

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'app_accounts', workspaceId);
                const docSnap = await getDoc(docRef);

                if (docSnap.exists() && docSnap.data().password === pass) {
                    currentWorkspace = workspaceId;
                    proceedToApp();
                } else {
                    showModal("Anmeldung fehlgeschlagen", "Benutzername oder Passwort ist nicht korrekt.");
                }
            } catch (error) {
                console.error("Login Error:", error);
                showModal("Fehler", "Server-Verbindung fehlgeschlagen.");
            }
        };

        // Logout Action
        document.getElementById('btn-do-logout').onclick = () => {
            currentWorkspace = null;
            isAppReady = false; 
            loadedCount = 0;
            
            if(unsubProducts) unsubProducts();
            if(unsubOrders) unsubOrders();
            if(unsubMissing) unsubMissing();
            
            authOverlay.classList.remove('hidden');
            setTimeout(() => authOverlay.classList.remove('opacity-0', 'pointer-events-none'), 10);
            
            // Clear UI
            document.getElementById('product-list-table').innerHTML = '';
            document.getElementById('production-list').innerHTML = '';
            document.getElementById('customer-orders-list').innerHTML = '';
            document.getElementById('missing-buttons-grid').innerHTML = '';
            document.getElementById('missing-summary-list').innerHTML = '';
        };

        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch(e) { console.error("Under-the-hood auth failed", e); }
        };

        const setupListeners = () => {
            if (!firebaseUser || !currentWorkspace) return;
            
            document.getElementById('loading-indicator').classList.remove('hidden');

            unsubProducts = onSnapshot(collection(db, getBasePath('products')), (snapshot) => {
                products = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                renderProductList();
                updateOrderProductSelect();
                renderMissingItemsButtons();
                checkLoadingComplete();
            }, (error) => console.error("Error products:", error));

            unsubOrders = onSnapshot(collection(db, getBasePath('orders')), (snapshot) => {
                orders = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                if(document.getElementById('tab-uebersicht').classList.contains('hidden') === false){
                    renderOverviews();
                }
                checkLoadingComplete();
            }, (error) => console.error("Error orders:", error));

            unsubMissing = onSnapshot(collection(db, getBasePath('missing_items')), (snapshot) => {
                missingItems = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                renderMissingSummary();
                checkLoadingComplete();
            }, (error) => console.error("Error missing items:", error));
        };

        let loadedCount = 0;
        
        const checkLoadingComplete = () => {
            loadedCount++;
            if (loadedCount >= 3 && !isAppReady) {
                isAppReady = true;
                document.getElementById('loading-indicator').classList.add('hidden');
