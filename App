                document.querySelectorAll('.filter-btn').forEach(b => {
                    b.classList.remove('bg-amber-100', 'text-amber-800', 'border-amber-300', 'active');
                    b.classList.add('bg-gray-100', 'text-gray-800', 'border-gray-300');
                });
                e.target.classList.remove('bg-gray-100', 'text-gray-800', 'border-gray-300');
                e.target.classList.add('bg-amber-100', 'text-amber-800', 'border-amber-300', 'active');
                currentFilter = e.target.dataset.filter;
                renderOverviews();
            });
        });

        const isDateInFilter = (dateStr, filter) => {
            const orderDate = new Date(dateStr);
            const today = new Date();
            today.setHours(0,0,0,0);
            
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            if (filter === 'today') {
                return dateStr === getTodayDateStr();
            } else if (filter === 'tomorrow') {
                return dateStr === getTomorrowDateStr();
            } else if (filter === 'week') {
                const day = today.getDay() || 7; 
                const firstDayOfWeek = new Date(today);
                firstDayOfWeek.setDate(today.getDate() - day + 1);
                const lastDayOfWeek = new Date(firstDayOfWeek);
                lastDayOfWeek.setDate(firstDayOfWeek.getDate() + 6);
                return orderDate >= firstDayOfWeek && orderDate <= lastDayOfWeek;
            } else if (filter === 'month') {
                return orderDate.getMonth() === today.getMonth() && orderDate.getFullYear() === today.getFullYear();
            }
            return true;
        };

        const renderOverviews = () => {
            const filterNames = { 'today': 'Heute', 'tomorrow': 'Morgen', 'week': 'Diese Woche', 'month': 'Dieser Monat' };
            document.getElementById('print-header-title').textContent = `Bestellübersicht (${filterNames[currentFilter]})`;
            document.getElementById('print-header-date').textContent = `Erstellt am: ${new Date().toLocaleString('de-DE')}`;

            const filteredOrders = orders.filter(o => isDateInFilter(o.datum, currentFilter));

            const productionTotals = {};
            filteredOrders.forEach(order => {
                order.items.forEach(item => {
                    if (!productionTotals[item.productId]) {
                        productionTotals[item.productId] = {
                            name: item.name,
                            teigart: item.teigart,
                            gewicht: item.gewicht,
                            totalQty: 0
                        };
